# App
ENVIRONMENT=development

# Auth
JWT_KEY=your-minimum-32-character-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGIN=http://localhost:0000

# Database
DEV_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/dev_database
# TEST_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/test_database
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/seatlock

# Email
# Preset A: Development
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=plaintext
SMTP_TIMEOUT_SECONDS=2
EMAIL_FROM_ADDRESS=no-reply@dev.seatlock.com
EMAIL_FROM_NAME=DevSeatLock

# Preset B: Testing
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURITY=plaintext
# SMTP_TIMEOUT_SECONDS=1
# EMAIL_FROM_ADDRESS=no-reply@test.seatlock.com
# EMAIL_FROM_NAME=SeatLock Test

# Preset C: Production
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SECONDS=10
# EMAIL_FROM_ADDRESS=your-email@gmail.com
# EMAIL_FROM_NAME=SeatLock
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
